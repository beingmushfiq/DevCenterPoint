<form class="admin-form" method="POST" action="<%= service.id ? `/admin/services/${service.id}/edit` : '/admin/services/new' %>">
  <% if (locals.csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>

  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-4);">
    <h2 style="font-family: var(--font-display); font-size: 1.25rem;"><%= service.id ? 'Edit Service' : 'Create Service' %></h2>
    <div style="display: flex; gap: var(--space-3);">
      <a class="btn btn--ghost" href="/admin/services">Cancel</a>
      <button class="btn btn--primary" type="submit">Save Service</button>
    </div>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="title">Discipline Title <span class="req">*</span></label>
      <input type="text" id="title" name="title" required value="<%= service.title || '' %>" placeholder="Web & Platform Engineering" />
    </div>

    <div class="field">
      <label class="field__label" for="slug">Slug <span class="req">*</span></label>
      <input type="text" id="slug" name="slug" required value="<%= service.slug || '' %>" placeholder="web-platform" />
    </div>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="tagline">Tagline / Short Descriptor</label>
      <input type="text" id="tagline" name="tagline" value="<%= service.tagline || '' %>" placeholder="Interfaces and services built for the load you do not have yet" />
    </div>

    <div class="field">
      <label class="field__label" for="icon_key">Icon Geometry Key</label>
      <select id="icon_key" name="icon_key">
        <option value="stack" <%= service.icon_key === 'stack' ? 'selected' : '' %>>Stack (Layers)</option>
        <option value="compass" <%= service.icon_key === 'compass' ? 'selected' : '' %>>Compass (Architecture / Exploration)</option>
        <option value="sprint" <%= service.icon_key === 'sprint' ? 'selected' : '' %>>Sprint (Motion / Speed)</option>
        <option value="migrate" <%= service.icon_key === 'migrate' ? 'selected' : '' %>>Migrate (Data / Transfer)</option>
        <option value="pulse" <%= service.icon_key === 'pulse' ? 'selected' : '' %>>Pulse (Reliability / Ops)</option>
        <option value="partners" <%= service.icon_key === 'partners' ? 'selected' : '' %>>Partners (Co-development)</option>
        <option value="mark" <%= service.icon_key === 'mark' ? 'selected' : '' %>>Mark (Default Diamond)</option>
      </select>
    </div>
  </div>

  <div class="field field--full">
    <label class="field__label" for="summary">Summary <span class="req">*</span></label>
    <textarea id="summary" name="summary" required rows="3" placeholder="Core overview of this capability..."><%= service.summary || '' %></textarea>
  </div>

  <div class="field field--full">
    <label class="field__label" for="body">Detailed Narrative (Markdown)</label>
    <textarea id="body" name="body" rows="10" placeholder="Full service specification..."><%= service.body || '' %></textarea>
  </div>

  <div class="field field--full">
    <label class="field__label" for="deliverables">Deliverables (One per line)</label>
    <textarea id="deliverables" name="deliverables" rows="5" placeholder="Full system architecture specification&#10;Production-ready Next.js / Node.js codebase&#10;Automated CI/CD pipeline"><%= (service.deliverables || []).join('\n') %></textarea>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="status">Status</label>
      <select id="status" name="status">
        <option value="draft" <%= service.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="published" <%= service.status === 'published' ? 'selected' : '' %>>Published</option>
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="sort_order">Sort Order</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= service.sort_order || 0 %>" />
    </div>
  </div>

  <div class="form__foot" style="margin-top: var(--space-8); border-top: 1px solid var(--color-border); padding-top: var(--space-6);">
    <button class="btn btn--primary" type="submit">Save Service</button>
    <a class="btn btn--ghost" href="/admin/services">Cancel</a>
  </div>
</form>
