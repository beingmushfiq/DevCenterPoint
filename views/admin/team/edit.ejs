<form class="admin-form" method="POST" action="<%= member.id ? `/admin/team/${member.id}/edit` : '/admin/team/new' %>">
  <% if (locals.csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>

  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-4);">
    <h2 style="font-family: var(--font-display); font-size: 1.25rem;"><%= member.id ? 'Edit Team Member' : 'Add Team Member' %></h2>
    <div style="display: flex; gap: var(--space-3);">
      <a class="btn btn--ghost" href="/admin/team">Cancel</a>
      <button class="btn btn--primary" type="submit">Save Member</button>
    </div>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="name">Full Name <span class="req">*</span></label>
      <input type="text" id="name" name="name" required value="<%= member.name || '' %>" placeholder="Elena Rostova" />
    </div>

    <div class="field">
      <label class="field__label" for="role">Role / Discipline <span class="req">*</span></label>
      <input type="text" id="role" name="role" required value="<%= member.role || '' %>" placeholder="Founding Engineer — Systems" />
    </div>
  </div>

  <div class="field field--full">
    <label class="field__label" for="bio">Bio</label>
    <textarea id="bio" name="bio" rows="3" placeholder="Background, engineering focus and previous work..."><%= member.bio || '' %></textarea>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="location">Location</label>
      <input type="text" id="location" name="location" value="<%= member.location || '' %>" placeholder="Dhaka &middot; Remote" />
    </div>

    <div class="field">
      <label class="field__label" for="email">Contact Email</label>
      <input type="email" id="email" name="email" value="<%= member.email || '' %>" placeholder="elena@devcenterpoint.com" />
    </div>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="photo_media_id">Photo</label>
      <select id="photo_media_id" name="photo_media_id">
        <option value="">No photo (use initials)</option>
        <% (mediaList || []).forEach(function (m) { %>
          <option value="<%= m.id %>" <%= member.photo_media_id === m.id ? 'selected' : '' %>><%= m.original_name %> (<%= m.path %>)</option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label class="field__label" for="status">Status</label>
      <select id="status" name="status">
        <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= member.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>
  </div>

  <div class="admin-form__row">
    <div class="field">
      <label class="field__label" for="sort_order">Sort Order</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= member.sort_order || 0 %>" />
    </div>
  </div>

  <div class="form__foot" style="margin-top: var(--space-8); border-top: 1px solid var(--color-border); padding-top: var(--space-6);">
    <button class="btn btn--primary" type="submit">Save Member</button>
    <a class="btn btn--ghost" href="/admin/team">Cancel</a>
  </div>
</form>
