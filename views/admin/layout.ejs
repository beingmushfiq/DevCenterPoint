<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title ? `${title} — ` : '' %>DevCenterPoint Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />
  <%- assetTags('admin').css %>
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('dcp-theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body class="admin">
  <aside class="sidebar">
    <a class="sidebar__brand" href="/admin" style="display: flex; align-items: center; justify-content: space-between;">
      <%- include('../partials/logo', { variant: 'admin' }) %>
      <span class="sidebar__badge">CMS</span>
    </a>

    <div class="sidebar__section">
      <span class="sidebar__label">Overview</span>
      <a class="sidebar__link <%= currentPath === '/admin' ? 'is-active' : '' %>" href="/admin">
        <span>Dashboard</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/submissions') ? 'is-active' : '' %>" href="/admin/submissions">
        <span>Enquiries</span>
      </a>
    </div>

    <div class="sidebar__section">
      <span class="sidebar__label">Content</span>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/cases') ? 'is-active' : '' %>" href="/admin/cases">
        <span>Case Studies</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/posts') ? 'is-active' : '' %>" href="/admin/posts">
        <span>Insights</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/updates') ? 'is-active' : '' %>" href="/admin/updates">
        <span>Updates</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/services') ? 'is-active' : '' %>" href="/admin/services">
        <span>Services</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/pages') ? 'is-active' : '' %>" href="/admin/pages">
        <span>Pages</span>
      </a>
    </div>

    <div class="sidebar__section">
      <span class="sidebar__label">Identity &amp; Proof</span>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/team') ? 'is-active' : '' %>" href="/admin/team">
        <span>Team</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/testimonials') ? 'is-active' : '' %>" href="/admin/testimonials">
        <span>Testimonials</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/faqs') ? 'is-active' : '' %>" href="/admin/faqs">
        <span>FAQs</span>
      </a>
    </div>

    <div class="sidebar__section">
      <span class="sidebar__label">System</span>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/media') ? 'is-active' : '' %>" href="/admin/media">
        <span>Media Library</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/nav') ? 'is-active' : '' %>" href="/admin/nav">
        <span>Navigation</span>
      </a>
      <a class="sidebar__link <%= currentPath.startsWith('/admin/settings') ? 'is-active' : '' %>" href="/admin/settings">
        <span>Settings</span>
      </a>
      <a class="sidebar__link" href="/status" target="_blank">
        <span>System Health &nearr;</span>
      </a>
    </div>

    <div class="sidebar__foot">
      <a class="sidebar__link" href="/" target="_blank">
        <span>View Live Site &nearr;</span>
      </a>
      <a class="sidebar__link" href="/admin/logout" style="color: var(--vermilion-400);">
        <span>Sign Out</span>
      </a>
    </div>
  </aside>

  <!-- Mobile backdrop -->
  <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

  <div class="admin-main">
    <header class="topbar">
      <button class="topbar__menu-toggle" id="sidebarToggle" type="button" aria-label="Toggle navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

      <div class="topbar__breadcrumb">
        <a href="/admin">Admin</a>
        <% if (locals.breadcrumb) { %>
          <span aria-hidden="true">/</span>
          <span><%= breadcrumb %></span>
        <% } %>
      </div>

      <div class="topbar__actions">
        <%- include('../partials/theme-toggle', { variant: 'admin' }) %>
        <% if (locals.topActions) { %>
          <%- topActions %>
        <% } %>
      </div>
    </header>

    <main class="admin-body">
      <% if (locals.flash) { %>
        <div class="toast-message toast-message--<%= flash.type || 'info' %>" data-toast>
          <div class="toast-message__icon"></div>
          <span><%= flash.message %></span>
          <button class="toast-message__close" type="button" aria-label="Dismiss notification">&times;</button>
        </div>
      <% } else if (locals.query && query.msg) { %>
        <div class="toast-message toast-message--<%= query.status === 'error' ? 'error' : 'ok' %>" data-toast>
          <div class="toast-message__icon"></div>
          <span><%= query.msg %></span>
          <button class="toast-message__close" type="button" aria-label="Dismiss notification">&times;</button>
        </div>
      <% } %>

      <%- body %>
    </main>
  </div>


  <%- assetTags('admin').js %>
</body>
</html>
