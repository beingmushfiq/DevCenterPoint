<% if (items && items.length > 0) { %>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Attribution</th>
          <th>Quote Excerpt</th>
          <th>Company</th>
          <th>Status</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function (t) { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: var(--space-3);">
                <div class="table-avatar" style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-surface-sunken); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--color-primary); flex: none;">
                  <%= (t.attribution || 'A').charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div class="admin-table__title">
                    <a href="/admin/testimonials/<%= t.id %>/edit"><%= t.attribution %></a>
                  </div>
                  <small style="color: var(--color-text-faint);"><%= t.role %></small>
                </div>
              </div>
            </td>
            <td>
              <p style="font-size: 0.8125rem; font-style: italic; max-width: 44ch; color: var(--color-text-muted);">“<%= truncate(t.quote, 95) %>”</p>
            </td>
            <td>
              <span class="badge" style="background: var(--color-surface-raised); border: 1px solid var(--color-border); color: var(--color-text); font-size: 0.75rem;"><%= t.company || '—' %></span>
            </td>
            <td>
              <span class="badge <%= t.status === 'active' || t.status === 'published' ? 'badge--published' : 'badge--draft' %>">
                <%= t.status %>
              </span>
            </td>
            <td>
              <div class="admin-table__actions">
                <a href="/admin/testimonials/<%= t.id %>/edit">Edit</a>
                <form method="POST" action="/admin/testimonials/<%= t.id %>/delete" style="display: inline;" onsubmit="return confirm('Delete this testimonial?');">
                  <% if (locals.csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
                  <button type="submit" class="danger" style="background:none; border:none; cursor:pointer; font-family:inherit; font-size:inherit;">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="note note--quiet">
    <p>No testimonials added yet. <a href="/admin/testimonials/new">Add a testimonial &rarr;</a></p>
  </div>
<% } %>
