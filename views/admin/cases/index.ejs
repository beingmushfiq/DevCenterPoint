<div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-6); flex-wrap: wrap;">
  <form method="GET" action="/admin/cases" style="display: flex; gap: var(--space-3); flex: 1; max-width: 540px; flex-wrap: wrap;">
    <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by title, client or summary..." class="admin-input" style="flex: 1; min-width: 200px;" />
    <% if (sectors && sectors.length > 0) { %>
      <select name="sector" class="admin-select">
        <option value="">All Sectors</option>
        <% sectors.forEach(function (s) { %>
          <% const secName = typeof s === 'object' && s ? (s.sector || s.name) : s; %>
          <option value="<%= secName %>" <%= sector === secName ? 'selected' : '' %>><%= secName %></option>
        <% }); %>
      </select>
    <% } %>
    <button class="btn btn--ghost" type="submit" style="padding: 6px 14px; font-size: 0.75rem;">Filter</button>
  </form>
</div>

<% if (items && items.length > 0) { %>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Project</th>
          <th>Sector</th>
          <th>Year</th>
          <th>Status</th>
          <th>Featured</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function (cs) { %>
          <tr>
            <td>
              <div class="admin-table__title">
                <a href="/admin/cases/<%= cs.id %>/edit"><%= cs.title %></a>
              </div>
              <small style="color: var(--color-text-faint);">
                Client: <%= cs.client_visibility === 'named' ? cs.client_name : (cs.client_label || 'Confidential') %>
                &middot; Slug: <code><%= cs.slug %></code>
              </small>
            </td>
            <td><span class="badge badge--draft"><%= cs.sector %></span></td>
            <td style="font-family: var(--font-mono); font-size: 0.8125rem;"><%= cs.year %></td>
            <td>
              <span class="badge <%= cs.status === 'published' ? 'badge--published' : 'badge--draft' %>">
                <%= cs.status %>
              </span>
            </td>
            <td>
              <% if (cs.is_featured) { %>
                <span class="badge badge--featured">Featured</span>
              <% } else { %>
                <span style="color: var(--color-text-faint);">&mdash;</span>
              <% } %>
            </td>
            <td>
              <div class="admin-table__actions">
                <a href="/work/<%= cs.slug %>" target="_blank" title="View live">Live &nearr;</a>
                <a href="/admin/cases/<%= cs.id %>/edit">Edit</a>
                <form method="POST" action="/admin/cases/<%= cs.id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this case study?');">
                  <% if (locals.csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
                  <button type="submit" class="danger" style="background:none; border:none; cursor:pointer; font-family:inherit; font-size:inherit;">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="note note--quiet">
    <p>No case studies found. <a href="/admin/cases/new">Create the first case study &rarr;</a></p>
  </div>
<% } %>
