<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login — DevCenterPoint</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />
  <%- assetTags('admin').css %>
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('dcp-theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <style>
    body.login-page {
      display: grid;
      place-items: center;
      min-height: 100vh;
      background: var(--color-bg);
      padding: var(--space-6);
      color: var(--color-text);
      font-family: var(--font-body);
      position: relative;
      transition: background-color var(--motion-base), color var(--motion-base);
    }
    .login-box {
      width: 100%;
      max-width: 420px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-10) var(--space-8);
      box-shadow: var(--glow-subtle);
    }
    .login-brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-6);
    }
    .login-glyph {
      width: 20px;
      height: 20px;
      background: var(--color-primary);
      position: relative;
    }
    .login-glyph::after {
      content: '';
      position: absolute;
      inset: 5px;
      background: var(--color-surface);
    }
    .login-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .login-sub {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin-bottom: var(--space-8);
    }
    .login-theme-pos {
      position: absolute;
      top: var(--space-6);
      right: var(--space-6);
    }
  </style>
</head>
<body class="login-page">
  <div class="login-theme-pos">
    <%- include('../partials/theme-toggle', { variant: 'admin' }) %>
  </div>
  <div class="login-box">
    <div class="login-brand" style="margin-bottom: var(--space-4);">
      <%- include('../partials/logo', { variant: 'header' }) %>
    </div>
    <p class="login-sub">Control Console &middot; Restricted Access</p>

    <% if (error) { %>
      <div class="flash-msg flash-msg--error">
        <span><%= error %></span>
      </div>
    <% } %>

    <form class="admin-form" method="POST" action="/admin/login">
      <% if (locals.csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% } %>
      <input type="hidden" name="next" value="<%= next || '/admin' %>" />

      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus value="<%= email || '' %>" placeholder="admin@devcenterpoint.com" />
      </div>

      <div class="field">
        <label class="field__label" for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="••••••••••••••••" />
      </div>

      <div style="margin-top: var(--space-4);">
        <button class="btn btn--primary" type="submit" style="width: 100%; justify-content: center; padding: 12px;">
          Authenticate &rarr;
        </button>
      </div>

      <div style="margin-top: var(--space-6); text-align: center;">
        <a href="/" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-faint);">&larr; Return to public site</a>
      </div>
    </form>
  </div>
  <%- assetTags('admin').js %>
</body>
</html>
