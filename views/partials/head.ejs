<%
  /* ============================================================
     DOCUMENT HEAD  +  OPENING BODY

     Every page starts with this include and ends with foot.ejs.
     EJS `include()` inherits the parent's locals, so `seo`, `site`,
     `nav`, `nonce` and the helpers are all available here without
     being passed again.

     Two inline scripts live in this block. Both carry the CSP
     nonce: in production the nonce is the only thing that lets
     them run, and in development the policy allows inline anyway,
     so the attribute is harmless either way.
     ============================================================ */
  const pageType = locals.pageType || 'detail';
  const bodyClass = locals.bodyClass || '';
  const tags = assetTags('site');

  /* ---- Organization schema (AEO/GEO entity anchor) --------
     This is the authoritative machine-readable description of
     DevCenterPoint. AI systems (Google AIO, Bing Copilot,
     Perplexity) use Organization JSON-LD as the primary source
     for entity identity. knowsAbout + sameAs are the two fields
     most aggressively ingested by LLMs during training/crawling.
     ---------------------------------------------------------- */
  const orgLd = {
    '@context': 'https://schema.org',
    '@type': ['Organization', 'ProfessionalService'],
    '@id': 'https://devcenterpoint.com/#organization',
    name: 'DevCenterPoint',
    alternateName: 'Dev Center Point',
    url: 'https://devcenterpoint.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://devcenterpoint.com/brand/logo.svg',
      width: 200,
      height: 60,
    },
    foundingDate: '2026',
    description: 'DevCenterPoint is a product engineering studio. We design, build, and stand behind enterprise software systems, cloud architectures, and digital platforms. Senior engineers only — discovery, architecture, and delivery as one continuous engagement, with no handoff.',
    slogan: 'Product engineering for systems that have to last.',
    email: site.email || 'hello@devcenterpoint.com',
    areaServed: 'Worldwide',
    knowsAbout: [
      'Software Engineering',
      'Product Engineering',
      'Cloud Architecture',
      'Web Platform Engineering',
      'Mobile App Development',
      'AI Systems Engineering',
      'DevOps and Site Reliability Engineering',
      'System Design and Architecture Review',
      'API Engineering',
      'Database Architecture',
      'Design Systems',
      'TypeScript',
      'React',
      'Node.js',
      'AWS',
      'Kubernetes',
      'Terraform',
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Engineering Services',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Architecture Review', description: 'Expert review of an existing system with written findings on where it will break and the three highest-return changes.', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Design Sprint', description: 'Pressure-testing an idea, scoping the smallest version worth shipping, and costing the whole project before a budget is committed.', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Full Delivery', description: 'Discovery through production, run by senior engineers — delivered in working slices with 30 days of post-handover support included.', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web and Platform Engineering', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Mobile and Offline-First Development', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Cloud and Platform Operations', url: 'https://devcenterpoint.com/services' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI and Decision Systems', url: 'https://devcenterpoint.com/services' } },
      ],
    },
    /* sameAs is the primary signal AI systems use to resolve entity
       identity and reject conflicting claims from other sources.
       Update the LinkedIn URL once the company page is created. */
    sameAs: [
      'https://devcenterpoint.com',
      'https://github.com/beingmushfiq',
      'https://github.com/DevCenterPoint',
      'https://www.linkedin.com/company/devcenterpoint',
    ].filter(Boolean),
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: site.email || 'hello@devcenterpoint.com',
      availableLanguage: 'English',
      contactOption: 'TollFree',
    },
  };

  /* WebSite schema — enables SearchAction rich result and anchors
     the site entity to the organisation entity via `publisher`. */
  const websiteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://devcenterpoint.com/#website',
    url: 'https://devcenterpoint.com',
    name: 'DevCenterPoint',
    description: 'Product engineering studio for systems that have to last.',
    publisher: { '@id': 'https://devcenterpoint.com/#organization' },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://devcenterpoint.com/api/search?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  };
%><!DOCTYPE html>
<html lang="en" data-theme="dark" data-page="<%= pageType %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= seo.title %></title>
  <% if (seo.description) { %><meta name="description" content="<%= seo.description %>" /><% } %>
  <% if (seo.noindex) { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } else { %>
  <!-- Allow Google to use full snippets and large images in AI Overviews -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <% } %>
  <meta name="author" content="DevCenterPoint" />
  <link rel="canonical" href="<%= seo.canonical %>" />
  <link rel="alternate" type="application/rss+xml" title="DevCenterPoint Insights" href="https://devcenterpoint.com/rss.xml" />

  <meta property="og:type" content="<%= seo.type || 'website' %>" />
  <meta property="og:site_name" content="<%= site.name %>" />
  <meta property="og:title" content="<%= seo.title %>" />
  <% if (seo.description) { %><meta property="og:description" content="<%= seo.description %>" /><% } %>
  <meta property="og:url" content="<%= seo.canonical %>" />
  <meta property="og:image" content="<%= url(seo.image || '/brand/og-image.svg') %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= seo.title %>" />
  <% if (seo.description) { %><meta name="twitter:description" content="<%= seo.description %>" /><% } %>
  <meta name="twitter:image" content="<%= url(seo.image || '/brand/og-image.svg') %>" />

  <meta name="theme-color" content="#07090e" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/brand/logo-mark.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />

  <%- tags.css %>

  <!-- Organization entity schema — authoritative AEO/GEO signal -->
  <script type="application/ld+json" nonce="<%= nonce %>"><%- jsonLd(orgLd) %></script>
  <!-- WebSite schema with SearchAction -->
  <script type="application/ld+json" nonce="<%= nonce %>"><%- jsonLd(websiteLd) %></script>
  <!-- Page-specific schema (set by individual routes/views) -->
  <% if (locals.schemaData) { %><script type="application/ld+json" nonce="<%= nonce %>"><%- jsonLd(schemaData) %></script><% } %>

  <script nonce="<%= nonce %>">
    /* Early theme resolution: prevents any flash of unstyled theme (FOUT) */
    (function() {
      try {
        var saved = localStorage.getItem('dcp-theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();

    /* Page type is read by the site entry to decide whether this
       page gets a WebGL field at all. */
    window.__DCP = { pageType: '<%= pageType %>', path: '<%= currentPath %>' };
    document.documentElement.classList.add('js');

    /* Fail-safe bootstrap.
       Content must never depend on JS succeeding. If the runtime has
       NOT signalled readiness in time, force-reveal the page and lift
       the boot overlay so the visitor always sees the site. */
    window.setTimeout(function () {
      if (window.__dcpReady) return;
      document.documentElement.classList.add('reveal-all');
      var b = document.getElementById('boot');
      if (b && !b.classList.contains('is-done')) b.classList.add('is-done');
    }, 2600);
  </script>
</head>
<body class="<%= bodyClass %>">
  <a class="skip-link" href="#top">Skip to content</a>

  <%- include('atmosphere') %>
  <%- include('boot') %>
  <%- include('nav') %>

  <main id="top">
