# ---------------------------------------------------------------
# DevCenterPoint — environment
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------

# --- Server ---
PORT=3000
SITE_URL=http://localhost:3000

# --- MySQL (Laragon defaults: user `root`, no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=devcenterpoint_cms
DB_POOL_SIZE=10

# --- Sessions ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Owner account (used once, by `npm run db:setup`) ---
ADMIN_EMAIL=admin@devcenterpoint.com
ADMIN_PASSWORD=replace-me-with-a-strong-password
ADMIN_NAME=Administrator
